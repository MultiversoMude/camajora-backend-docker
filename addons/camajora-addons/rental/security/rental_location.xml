    <field name="perm_unlink" eval="0" />
  </record>

  <record model="ir.model.access" id="rental_location_access_manager">
    <field name="name">rental.location.manager</field>
    <field name="model_id" ref="model_rental_location" />
    <field name="group_id" ref="rental.group_rental_manager" />
