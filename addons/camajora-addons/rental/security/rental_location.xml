  <record id="rental_location_rule_owner" model="ir.rule">
    <field name="name">rental.location.owner</field>
    <field name="model_id" ref="model_rental_location" />
    <field name="groups" eval="[(6,0, [ref('rental.group_rental_owner')])]" />
