  </record>

  <record id="rental_location_rule_backoffice" model="ir.rule">
    <field name="name">rental.location.backoffice</field>
    <field name="model_id" ref="model_rental_location" />
    <field name="groups" eval="[(6,0, [ref('rental.group_rental_backoffice')])]" />
    <field name="domain_force">[(1,'=',1)]</field>
  </record>

  <record id="rental_location_rule_manager" model="ir.rule">
    <field name="name">rental.location.manager</field>
    <field name="model_id" ref="model_rental_location" />
    <field name="groups" eval="[(6,0, [ref('rental.group_rental_manager')])]" />
