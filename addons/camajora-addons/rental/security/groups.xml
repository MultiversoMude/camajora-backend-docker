<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <data>
    <record model="ir.module.category" id="rental_groups">
      <field name="name">Rental</field>
      <field name="description">User access level for Rental app</field>
      <field name="sequence">20</field>
    </record>

    <record id="group_access_to_partners" model="res.groups">
      <field name="name">Access to Partners</field>
      <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_rental_customer" model="res.groups">
      <field name="name">Customer</field>
      <field name="category_id" ref="rental_groups" />
      <field name="implied_ids" eval="[(4, ref('base.group_portal'))]" />
    </record>

    <record id="group_rental_api" model="res.groups">
      <field name="name">API</field>
      <field name="category_id" ref="rental_groups" />
      <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_rental_owner" model="res.groups">
      <field name="name">Owner</field>
      <field name="category_id" ref="rental_groups" />
      <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_rental_backoffice" model="res.groups">
      <field name="name">Backoffice</field>
      <field name="category_id" ref="rental_groups" />
      <field name="implied_ids" eval="[(4, ref('rental.group_rental_owner'))]" />
    </record>

    <record id="group_rental_manager" model="res.groups">
      <field name="name">Manager</field>
      <field name="category_id" ref="rental_groups" />
      <field name="implied_ids" eval="[(4, ref('rental.group_rental_backoffice'))]" />
    </record>
  </data>

</odoo>
