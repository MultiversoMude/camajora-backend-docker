<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record model="ir.model.access" id="rental_booking_access_customer">
    <field name="name">rental.booking.customer</field>
    <field name="model_id" ref="model_rental_booking" />
    <field name="group_id" ref="rental.group_rental_customer" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_unlink" eval="0" />
  </record>

  <record model="ir.model.access" id="rental_booking_access_api">
    <field name="name">rental.booking.api</field>
    <field name="model_id" ref="model_rental_booking" />
    <field name="group_id" ref="rental.group_rental_api" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="0" />
    <field name="perm_write" eval="0" />
    <field name="perm_unlink" eval="0" />
  </record>

  <record model="ir.model.access" id="rental_booking_access_owner">
    <field name="name">rental.booking.owner</field>
    <field name="model_id" ref="model_rental_booking" />
    <field name="group_id" ref="rental.group_rental_owner" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="0" />
    <field name="perm_write" eval="0" />
    <field name="perm_unlink" eval="0" />
  </record>

  <record model="ir.model.access" id="rental_booking_access_backoffice">
    <field name="name">rental.booking.backoffice</field>
    <field name="model_id" ref="model_rental_booking" />
    <field name="group_id" ref="rental.group_rental_backoffice" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_unlink" eval="0" />
  </record>

  <record model="ir.model.access" id="rental_booking_access_manager">
    <field name="name">rental.booking.manager</field>
    <field name="model_id" ref="model_rental_booking" />
    <field name="group_id" ref="rental.group_rental_manager" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_unlink" eval="1" />
  </record>

  <record id="rental_booking_rule_customer" model="ir.rule">
    <field name="name">rental.booking.customer</field>
    <field name="model_id" ref="model_rental_booking" />
    <field name="groups" eval="[(6,0, [ref('rental.group_rental_customer')])]" />
    <field name="domain_force">[('user_id','=',user.partner_id.id)]</field>
  </record>

  <record id="rental_booking_rule_owner" model="ir.rule">
    <field name="name">rental.booking.owner</field>
    <field name="model_id" ref="model_rental_booking" />
    <field name="groups" eval="[(6,0, [ref('rental.group_rental_owner')])]" />
    <field name="domain_force">['|',('slot_ids.resource_instance_id.resource_id.partner_id','=',user.partner_id.id), ('slot_ids.resource_instance_id.resource_id.partner_id','=',user.partner_id.parent_id.id)]</field>
  </record>

  <record id="rental_booking_rule_backoffice" model="ir.rule">
    <field name="name">rental.booking.backoffice</field>
    <field name="model_id" ref="model_rental_booking" />
    <field name="groups" eval="[(6,0, [ref('rental.group_rental_backoffice')])]" />
    <field name="domain_force">[(1,'=',1)]</field>
  </record>

  <record id="rental_booking_rule_manager" model="ir.rule">
    <field name="name">rental.booking.manager</field>
    <field name="model_id" ref="model_rental_booking" />
    <field name="groups" eval="[(6,0, [ref('rental.group_rental_manager')])]" />
    <field name="domain_force">[(1,'=',1)]</field>
  </record>

</odoo>
