<?xml version="1.0" encoding="utf-8"?>

<odoo>
  <record id="generate_instances_wizard_view_form" model="ir.ui.view">
    <field name="name">rental.resource.instance.wizard.form</field>
    <field name="model">rental.resource.instance.wizard</field>
    <field name="arch" type="xml">
      <form string="Generate Coupons">
        <group>
          <field name="count" />
          <field name="equipments_ids" />
        </group>
        <footer>
          <button name="generate_instances" type="object" string="Generate" class="oe_highlight" />
          <button special="cancel" string="Cancel" />
        </footer>
      </form>
    </field>
  </record>

  <record id="generate_instances_wizard_action" model="ir.actions.act_window">
    <field name="name">Number of Instances To Generate</field>
    <field name="res_model">rental.resource.instance.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="view_id" ref="generate_instances_wizard_view_form" />
  </record>
</odoo>
