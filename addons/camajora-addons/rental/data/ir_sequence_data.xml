<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record model="ir.sequence" id="rental_booking_sequence">
      <field name="name">Booking sequence</field>
      <field name="code">rental.booking.sku</field>
      <field name="active">TRUE</field>
      <field name="prefix">SKU</field>
      <field name="padding">5</field>
      <field name="number_next">1</field>
      <field name="number_increment">1</field>
    </record>
    <record model="ir.sequence" id="rental_resource_sequence">
      <field name="name">Resource sequence</field>
      <field name="code">rental.resource.code</field>
      <field name="active">TRUE</field>
      <field name="prefix">RES</field>
      <field name="padding">5</field>
      <field name="number_next">1</field>
      <field name="number_increment">1</field>
    </record>
    <record model="ir.sequence" id="rental_resource_instance_sequence">
      <field name="name">Resource Instance equence</field>
      <field name="code">rental.resource.instance.code</field>
      <field name="active">TRUE</field>
      <field name="prefix">SKU</field>
      <field name="padding">5</field>
      <field name="number_next">1</field>
      <field name="number_increment">1</field>
    </record>
  </data>
</odoo>
