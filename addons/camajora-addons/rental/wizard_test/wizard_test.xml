<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="my_wizard_form" model="ir.ui.view">
        <field name="name">my.wizard.form</field>
        <field name="model">my.wizard</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="multi_step_wizard.multi_step_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//footer" position="before">
                <header>
                <h1>Prenotazione</h1>
                    <field name="state" widget="statusbar" />
                </header>

                <group name="initial" attrs="{'invisible': [('state', '!=', 'start')]}">
                    <group>
                        <field name="location_id" attrs="{'readonly': 1,'invisible': 1}"/>
                        <field name="name" class="oe_inline" attrs="{'readonly': 1}"/>
                        <field name="resource_id" widget="many2one_tags" attrs="{'readonly': 1}"/>
                        <field name="instances_ids" widget="many2one_tags" domain="[('resource_id.id', '=', context.get('default_resource_id'))]"/>
                    </group>
                </group>

                <group attrs="{'invisible': [('state', '!=', 'start')]}">
                        <field name="date" attrs="{'invisible': 1}"/>
                        <field name="user_id"/>
                        <field name="duration" attrs="{'invisible': 1}" />
                        <field name="duration_id" />
                        <field name="start_date" />
                        <field name="end_date" attrs="{'invisible': [('duration','in',['hourly', 'half_daily'])]}" />
                        <field name="start_time" attrs="{'invisible': [('duration','!=','hourly')]}" />
                        <field name="end_time" attrs="{'invisible': [('duration','!=','hourly')]}" />
                        <field name="half_day_type" attrs="{'invisible': [('duration','!=','half_daily')]}" />
                        <field name="total_hours" />
                       <field name="dt_start" />
                       <field name="dt_end" />
                </group>
                <group name="final"   attrs="{'invisible': [('state', '!=', 'final')]}">
                        <p>Prentazione inserita con successo</p>
                </group>

            </xpath>
        </field>
    </record>


    <act_window id="open_my_wizard"
                name="Prenotazione"
                res_model="my.wizard"
                src_model="rental.location"
                view_mode="form"
                target="new"
                view_type="form"
                context="{'default_resource_id':active_id}"/>
</odoo>
