<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- App Menu Entry -->
  <record model="ir.ui.menu" id="rental_main_menu">
    <field name="name">Rental</field>
    <field name="web_icon">rental,static/description/icon.png</field>
    <field name="action" ref="rental_booking_act_window" />
    <field name="sequence" eval="30" />
  </record>
  <!-- Booking Menu -->
  <record model="ir.ui.menu" id="rental_booking_menu">
    <field name="name">Booking</field>
    <field name="parent_id" ref="rental_main_menu" />
    <field name="sequence" eval="10" />
  </record>
  <record model="ir.ui.menu" id="rental_booking_menu_item">
    <field name="name">Booking</field>
    <field name="parent_id" ref="rental_booking_menu" />
    <field name="action" ref="rental_booking_act_window" />
    <field name="sequence" eval="10" />
  </record>
  <record model="ir.ui.menu" id="rental_booking_slot_report_menu">
    <field name="name">Calendario Prenotazioni</field>
    <field name="action" ref="rental_booking_slot_act_window" />
    <field name="parent_id" ref="rental_main_menu" />
    <field name="sequence" eval="11" />
  </record>
  <!-- Resource Menu -->
  <record model="ir.ui.menu" id="rental_resource_main_menu">
    <field name="name">Resources</field>
    <field name="parent_id" ref="rental_main_menu" />
    <field name="action" ref="rental_resource_act_window" />
    <field name="sequence" eval="20" />
  </record>
  <record model="ir.ui.menu" id="rental_resource_menu">
    <field name="name">Resources</field>
    <field name="parent_id" ref="rental_resource_main_menu" />
    <field name="action" ref="rental_resource_act_window" />
    <field name="sequence" eval="10" />
  </record>
  <record model="ir.ui.menu" id="rental_resource_type_menu">
    <field name="name">Resource Types</field>
    <field name="parent_id" ref="rental_resource_main_menu" />
    <field name="action" ref="rental_resource_type_act_window" />
    <field name="sequence" eval="20" />
  </record>
  <record model="ir.ui.menu" id="rental_resource_instance_main_menu">
    <field name="name">Resource Instances</field>
    <field eval="[(6,0,[ref('base.group_no_one')])]" name="groups_id" />
    <field name="parent_id" ref="rental_resource_main_menu" />
    <field name="action" ref="rental_resource_instance_act_window" />
    <field name="sequence" eval="30" />
  </record>
  <!-- Location Menu -->
  <record model="ir.ui.menu" id="rental_location_menu">
    <field name="name">Locations</field>
    <field name="parent_id" ref="rental_main_menu" />
    <field name="action" ref="rental_location_act_window" />
    <field name="sequence" eval="30" />
  </record>
  <!-- Config Menu -->
  <record model="ir.ui.menu" id="rental_configuration_menu">
    <field name="name">Configuration</field>
    <field name="parent_id" ref="rental_main_menu" />
    <field name="groups_id" eval="[(6,0,[ref('rental.group_rental_backoffice'), ref('rental.group_rental_manager')])]" />
    <field name="action" ref="rental_resource_act_window" />
    <field name="sequence" eval="40" />
  </record>
  <record model="ir.ui.menu" id="rental_resource_category_menu">
    <field name="name">Category</field>
    <field name="parent_id" ref="rental_configuration_menu" />
    <field name="action" ref="rental_resource_category_act_window" />
    <field name="sequence" eval="10" />
  </record>
  <record model="ir.ui.menu" id="rental_resource_equipment_menu">
    <field name="name">Equipment</field>
    <field name="parent_id" ref="rental_configuration_menu" />
    <field name="action" ref="rental_resource_equipment_act_window" />
    <field name="sequence" eval="20" />
  </record>
  <record model="ir.ui.menu" id="rental_resource_performance_menu">
    <field name="name">Performance</field>
    <field name="parent_id" ref="rental_configuration_menu" />
    <field name="action" ref="rental_resource_performance_act_window" />
    <field name="sequence" eval="30" />
  </record>
  <record model="ir.ui.menu" id="rental_resource_setup_menu">
    <field name="name">Setup</field>
    <field name="parent_id" ref="rental_configuration_menu" />
    <field name="action" ref="rental_resource_setup_act_window" />
    <field name="sequence" eval="40" />
  </record>
  <record model="ir.ui.menu" id="rental_resource_size_menu">
    <field name="name">Size</field>
    <field name="parent_id" ref="rental_configuration_menu" />
    <field name="action" ref="rental_resource_size_act_window" />
    <field name="sequence" eval="50" />
  </record>
  <record model="ir.ui.menu" id="rental_availability_menu">
    <field name="name">Availability</field>
    <field name="parent_id" ref="rental_configuration_menu" />
    <field name="action" ref="rental_availability_act_window" />
    <field name="sequence" eval="60" />
  </record>
  <record model="ir.ui.menu" id="rental_duration_menu">
    <field name="name">Duration</field>
    <field name="parent_id" ref="rental_configuration_menu" />
    <field name="action" ref="rental_duration_act_window" />
    <field name="sequence" eval="70" />
  </record>

</odoo>
