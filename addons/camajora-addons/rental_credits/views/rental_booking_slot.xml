 <?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record model="ir.ui.view" id="rental_booking_slot_form_view">
    <field name="name">rental.booking.slot.form (in rental_credits)</field>
    <field name="model">rental.booking.slot</field>
    <field name="inherit_id" ref="rental.rental_booking_slot_form_view" />
    <field name="arch" type="xml">
      <field name="end_time" position="after">
        <field name="credit_cost" />
        <field name="credit_total" />
      </field>
    </field>
  </record>

  <record id="rental_booking_slot_pivot_view" model="ir.ui.view">
      <field name="name">rental.booking.slot.pivot</field>
      <field name="model">rental.booking.slot</field>
      <field name="arch" type="xml">
          <pivot string="Slots" disable_linking="True">
              <field name="create_date" type="row"/>
              <field name="owner_id" type="row"/>
              <field name="credit_total" type="measure"/>
          </pivot>
      </field>
  </record>

</odoo>
