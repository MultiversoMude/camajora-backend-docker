<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- App Menu Entry -->
  <record model="ir.ui.menu" id="rental_website_main_menu">
    <field name="name">Rental Website</field>
    <field name="web_icon">rental,static/description/icon.png</field>
    <field name="action" ref="home_config_act_window" />
    <field name="sequence" eval="40" />
  </record>
  <!-- Home Menu -->
  <record model="ir.ui.menu" id="rental_website_home_menu">
    <field name="name">Home</field>
    <field name="parent_id" ref="rental_website_main_menu" />
    <field name="action" ref="home_config_act_window" />
    <field name="sequence" eval="10" />
  </record>

</odoo>
