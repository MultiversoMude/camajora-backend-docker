<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- wizard action on res.partner -->
  <act_window id="partner_wizard_action" name="Grant Owner Access" src_model="res.partner" res_model="owner.onboarding.wizard" view_type="form" view_mode="form" key2="client_action_multi" target="new" groups="rental.group_rental_backoffice" />

  <!-- wizard view -->
  <record id="wizard_view" model="ir.ui.view">
    <field name="name">Grant Owner Access</field>
    <field name="model">owner.onboarding.wizard</field>
    <field name="arch" type="xml">
      <form string="Grant Owner Access">
        <div>
          Select which contacts should be owners in the list below.
          The email address of each selected contact must be valid and unique.
          If necessary, you can fix any contact's email address directly in the list.
        </div>
        <field name="user_ids">
          <tree string="Contacts" editable="bottom" create="false" delete="false">
            <field name="partner_id" force_save="1" />
            <field name="email" />
            <field name="is_owner" />
          </tree>
        </field>
        <field name="welcome_message" placeholder="This text is included in the email sent to new owners." />
        <footer>
          <button string="Apply" name="action_apply" type="object" class="btn-primary" />
          <button string="Cancel" class="btn-secondary" special="cancel" />
        </footer>
      </form>
    </field>
  </record>

</odoo>
