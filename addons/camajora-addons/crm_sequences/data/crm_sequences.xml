<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="sequence_lead" model="ir.sequence">
            <field name="name">Leads sequence</field>
            <field name="code">crm.lead</field>
            <field eval="1" name="number_next"/>
            <field eval="1" name="number_increment"/>
            <field eval="False" name="company_id"/>
            <field name="padding">6</field>
        </record>

        <record id="sequence_partner" model="ir.sequence">
            <field name="name">Partners sequence</field>
            <field name="code">res.partner</field>
            <field eval="1" name="number_next"/>
            <field eval="1" name="number_increment"/>
            <field eval="False" name="company_id"/>
            <field name="padding">6</field>
        </record>

        <record model="ir.cron" id="recalculate_missing_crm_lead_codes">
           <field name="name">Recalculate Missing CRM Code</field>
           <field name="active">False</field>
           <field name="interval_number">1</field>
           <field name="interval_type">days</field>
           <field name="numbercall">-1</field>
           <field name="model_id" ref="model_crm_lead"/>
           <field name="code">model._cron_update_missing_codes()</field>
        </record>  

        <record model="ir.cron" id="recalculate_missing_res_partner_codes">
           <field name="name">Recalculate Missing Partners Code</field>
           <field name="active">False</field>
           <field name="interval_number">1</field>
           <field name="interval_type">days</field>
           <field name="numbercall">-1</field>
           <field name="model_id" ref="model_res_partner"/>
           <field name="code">model._cron_update_missing_codes()</field>
        </record>  
        
    </data>
</odoo>
