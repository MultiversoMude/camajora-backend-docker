<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record model="ir.ui.view" id="rental_location_form_view">
    <field name="name">rental.location.form (in rental_kafka)</field>
    <field name="model">rental.location</field>
    <field name="inherit_id" ref="rental.rental_location_form_view" />
    <field name="arch" type="xml">
      <field name="resource_ids" position="after">
        <field name="kafka_configuration" />
      </field>
    </field>
  </record>

  <record model="ir.ui.view" id="rental_location_tree_view">
    <field name="name">rental.location.tree (in rental_kafka)</field>
    <field name="model">rental.location</field>
    <field name="inherit_id" ref="rental.rental_location_tree_view" />
    <field name="arch" type="xml">
      <field name="country_id" position="after">
        <field name="kafka_configuration" />
      </field>
    </field>
  </record>

</odoo>
