<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <data noupdate="1">
    <!-- Email template for reset password -->
    <record id="user_password_reset_email" model="mail.template">
      <field name="name">Boxy: Password reset email</field>
      <field name="model_id" ref="base.model_res_users"/>
      <field name="subject">Someone requested a password reset for your Boxy account</field>
      <field name="email_from">${('"Boxy" &lt;%s&gt;' % (user.email))|safe}</field>
      <field name="email_to">${object.email_formatted | safe}</field>
      <field name="auto_delete" eval="True"/>
      <field name="body_html"><![CDATA[
<div style="padding:0px;width:600px;margin:auto;background: #FFFFFF repeat top /100%;color:#777777">
  <p>Dear ${object.name},</p>
  <p>Someone requested a password reset for your Boxy account</p>
  <p>You can follow this link to create a new password:</p>

  <div style="text-align: center; margin-top: 16px;">
    <a href="${object.password_reset_url}" style="padding: 5px 10px; font-size: 12px; line-height: 18px; color: #FFFFFF; border-color:#875A7B; text-decoration: none; display: inline-block; margin-bottom: 0px; font-weight: 400; text-align: center; vertical-align: middle; cursor: pointer; white-space: nowrap; background-image: none; background-color: #875A7B; border: 1px solid #875A7B; border-radius:3px">Reset password</a>
  </div>
  <p>If you didn’t want to create a new password, you can safely ignore this email and carry on as usual.</p>
</div>]]></field>    
    </record>
  </data>

</odoo>

