<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record model="ir.ui.view" id="rental_resource_form_view">
    <field name="name">rental.resource.form (in rental_credits)</field>
    <field name="model">rental.resource</field>
    <field name="inherit_id" ref="rental.rental_resource_form_view" />
    <field name="arch" type="xml">
      <field name="type_id" position="after">
        <field name="credit_cost" />
      </field>
    </field>
  </record>

  <record model="ir.ui.view" id="rental_resource_tree_view">
    <field name="name">rental.resource.tree (in rental_credits)</field>
    <field name="model">rental.resource</field>
    <field name="inherit_id" ref="rental.rental_resource_tree_view" />
    <field name="arch" type="xml">
      <field name="type_id" position="after">
        <field name="credit_cost" />
      </field>
    </field>
  </record>

</odoo>
